# ─────────────────────────────────────────────
#  Plutus – .gitignore
# ─────────────────────────────────────────────


# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checkers
.mypy_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/


# ── Logs & runtime data ───────────────────────
*.log
uvicorn.log
SyncLogs/

# Screener session pickle — runtime auth cache, never commit
screener_session.pkl
*.pkl

# Never commit raw market / personal data CSVs
*.csv
# Exception – keep the master universe template tracked (seed_universe input)
!UserData/Vicky - Master Template - Master.csv


# ── Frontend (frontend_v2 · React / Vite) ─────
node_modules/
frontend_v2/dist/
frontend_v2/.vite/
*.tsbuildinfo

# Local env overrides
frontend_v2/.env
frontend_v2/.env.*
!frontend_v2/.env.example

.cache/
.parcel-cache/


# ── Supabase local stack ──────────────────────
supabase/.branches/
supabase/.temp/


# ── OS & Editor artefacts ─────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
\#*\#


# ── Secrets & Credentials ─────────────────────
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json


# ── Misc ──────────────────────────────────────
.bin/
*.bak
*.tmp
