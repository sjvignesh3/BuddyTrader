# Plutus environment configuration
# Copy to `.env` (never commit) and fill in real values.

# ---- Supabase (required) ----
PLUTUS_SUPABASE_URL=https://<project-ref>.supabase.co
PLUTUS_SUPABASE_SERVICE_KEY=<service-role-key>
PLUTUS_SUPABASE_ANON_KEY=<anon-key>          # Optional; frontend-only

# ---- yfinance tuning (optional) ----
PLUTUS_YF_TIMEOUT_SECONDS=30
PLUTUS_YF_MAX_RETRIES=3
PLUTUS_YF_BATCH_SIZE=50

# ---- Sync worker (optional) ----
PLUTUS_SYNC_BATCH_SIZE=50
PLUTUS_SYNC_HISTORY_YEARS=5

# ---- Market-cap bucket thresholds (optional, in ₹ crores) ----
# Defaults are Vicky's criteria: Large >= 1,00,000 Cr, Mid >= 30,000 Cr,
# Small >= 10,000 Cr, Micro below. Override here to retune without a
# code change.
# PLUTUS_CAP_LARGE_MIN_CR=100000
# PLUTUS_CAP_MID_MIN_CR=30000
# PLUTUS_CAP_SMALL_MIN_CR=10000

# ---- Screener.in (REQUIRED for the quarterly Tier-B sync) ----
# Screener renders data only for logged-in users; the quarterly worker
# aborts fast without credentials. Same var names as legacy Buddy.
SCREENER_EMAIL=your@email.com
SCREENER_PASSWORD=yourpassword
# Cooldown between per-symbol fetches (screener rate-limit etiquette).
# Applied when more than 5 symbols are synced; default 15.
PLUTUS_SCREENER_COOLDOWN_S=15

# ---- Alerting (optional — unset disables alerting entirely) ----
# PLUTUS_ALERT_WEBHOOK=https://hooks.slack.com/services/...
# PLUTUS_ALERT_TIMEOUT_S=10
# PLUTUS_ALERT_MAX_RETRIES=3

# ---- On-demand sync trigger (optional — API service only) ----
# Lets the frontend Sync tab dispatch the GitHub Actions sync workflows.
# The PAT needs ONLY "Actions: Read and write" on this repo (fine-grained
# token) — never commit it; it stays on the API host.
# PLUTUS_GITHUB_TOKEN=github_pat_...
# PLUTUS_GITHUB_REPO=<owner>/<repo>          # e.g. sjvignesh3/BuddyTrader
# PLUTUS_GITHUB_REF=main                     # branch to dispatch (default main)
# Shared secret the browser must present (X-Plutus-Admin-Token header).
# REQUIRED in prod for the trigger to work; unset in dev = open locally.
# PLUTUS_ADMIN_TOKEN=<any-long-random-string>

# ---- App password (personal tools gate) ----
# Locks /api/journal, /api/expenses, /api/sizing and /api/networth behind a
# shared password. The browser POSTs it once to /api/auth/login and gets a
# signed token back; changing this value signs every browser out.
#   set          -> token required on those routes.
#   unset + dev  -> open (so local dev needs no password).
#   unset + prod -> those routes return 503 until you set it.
# REQUIRED in prod — without it your journal and net worth are world-readable.
# PLUTUS_APP_PASSWORD=<a long passphrase you will remember>
# PLUTUS_AUTH_TTL_DAYS=30       # how long a browser stays signed in
# PLUTUS_AUTH_SECRET=           # optional extra entropy for token signing
#
# The VIEW-ONLY password is NOT an env var — it is generated and rotated
# from the app's Console and stored (hashed) in the app_access table.
# Apply migration 018_app_access.sql to enable it.

# ---- Runtime (optional) ----
PLUTUS_ENV=dev                # dev | staging | prod
PLUTUS_LOG_LEVEL=INFO
