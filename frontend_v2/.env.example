# Copy to .env.local for local dev, or set in your Pages/Vercel dashboard for prod.
#
# In production, VITE_PLUTUS_API_URL is the Supabase Edge Function base URL:
#   https://<project-ref>.functions.supabase.co/plutus-api
#
# In local dev, `supabase functions serve plutus-api` exposes it at:
#   http://localhost:54321/functions/v1/plutus-api
#
# The FastAPI dev server (http://localhost:8000) remains a valid target — the
# routes are byte-identical.

VITE_PLUTUS_API_URL=http://localhost:54321/functions/v1/plutus-api
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
