# Copy to .env.local for local dev, or set in your Vercel dashboard for prod.
#
# VITE_PLUTUS_API_URL is the base URL of the Plutus FastAPI backend
# (plutus/api/app.py). It serves the read endpoints plus the Journal,
# Expenses, Position Sizer and Net Worth write endpoints.
#
#   Local dev : python -m plutus.scripts.run_api   ->  http://127.0.0.1:8000
#   Production: the Render web service, e.g. https://plutus-api.onrender.com
#               (see Docs/Plutus_Free_Hosting_Guide.md)
#
# The read-only Supabase Edge Function (supabase/functions/plutus-api) is an
# optional fallback for the read routes only — it has no personal-tool routes.

VITE_PLUTUS_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
