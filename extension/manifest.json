{
  "manifest_version": 3,
  "name": "Plutus Companion",
  "short_name": "Plutus",
  "version": "0.7.0",
  "description": "Plutus overlays for TradingView, Screener.in and the US research sites: pool watchlists with instant symbol switching, live prices, Plutus signals and fundamental score, ratio colour-coding, labels, notes and PlayArea from any chart.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Plutus Companion",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*",
    "https://tradingview.com/*",
    "https://*.screener.in/*",
    "https://screener.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.stockanalysis.com/*",
    "https://stockanalysis.com/*",
    "https://*.roic.ai/*",
    "https://roic.ai/*",
    "https://*.vcpscanner.com/*",
    "https://vcpscanner.com/*",
    "https://*.stockresearch.app/*",
    "https://stockresearch.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/chart*",
        "https://tradingview.com/chart*"
      ],
      "js": [
        "shared/symbols.js",
        "shared/settings.js",
        "shared/ui.js",
        "shared/panel_logic.js",
        "shared/card.js",
        "shared/sizer.js",
        "tv/tv_content.js"
      ],
      "css": [
        "tv/tv.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.screener.in/*",
        "https://screener.in/*"
      ],
      "js": [
        "shared/symbols.js",
        "shared/settings.js",
        "shared/ui.js",
        "shared/card.js",
        "shared/sizer.js",
        "vendor/chart.min.js",
        "screener/screener_content.js"
      ],
      "css": [
        "screener/screener.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.stockanalysis.com/stocks/*",
        "https://stockanalysis.com/stocks/*",
        "https://*.roic.ai/*",
        "https://roic.ai/*",
        "https://*.vcpscanner.com/stock/*",
        "https://vcpscanner.com/stock/*",
        "https://*.stockresearch.app/stocks/*",
        "https://stockresearch.app/stocks/*"
      ],
      "js": [
        "shared/symbols.js",
        "shared/settings.js",
        "shared/ui.js",
        "shared/table_colour.js",
        "us/us_sites.js"
      ],
      "css": [
        "us/us.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "shared/settings.js",
        "webapp/token_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
